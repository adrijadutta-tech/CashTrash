# Copy this file to .env before running the server

PORT=4000

# Any long random string — used to sign login tokens
JWT_SECRET=change-this-to-a-long-random-string

# How long a login stays valid
JWT_EXPIRES_IN=7d

# Where the SQLite database file is created (relative to backend/)
DATABASE_FILE=./data/cashtrash.db

# Comma-separated list of frontend origins allowed to call this API.
# "null" is included because opening the HTML files directly by double-click
# (file://) sends that as the Origin header. Using a local dev server (VS
# Code "Live Server", `npx http-server`, etc.) instead of file:// is more
# reliable — the ports below cover common ones.
CORS_ORIGIN=null,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000
